# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Leave empty for SQLite. Example: postgres://user:pass@localhost:5432/algo_trader
DATABASE_URL=

# --- Massive (formerly Polygon.io) market data ---
MASSIVE_API_KEY=
# Use https://api.polygon.io if your key is a legacy Polygon key
MASSIVE_BASE_URL=https://api.massive.com

# --- SnapTrade ---
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
# "commercial" or "personal" depending on the type of SnapTrade API key you have
SNAPTRADE_KEY_TYPE=commercial
# Where SnapTrade sends the user back after connecting a brokerage
SNAPTRADE_REDIRECT_URL=http://127.0.0.1:8000/accounts/connect/callback/

# --- Trading safety switches ---
# False = strategies only log signals (dry run); no orders are sent.
TRADING_ENABLED=False
# False = connect Alpaca *paper* account (ALPACA-PAPER). True = real-money Alpaca.
LIVE_TRADING=False
